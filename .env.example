# .env.example — Copy this file to .env and fill in your real values.
# NEVER commit .env to git. It is already in .gitignore.

# --- OpenWeather Air Pollution API (REQUIRED for live data ingestion) ---
# Get a free key at: https://openweathermap.org/appid
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE

# --- Supabase (OPTIONAL — leave blank to use local SQLite instead) ---
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY_HERE

# --- Ingestion Endpoint Security ---
# Protects the /api/v1/ingest endpoint. Use a long random string.
# Must match the INGEST_TOKEN secret in GitHub Actions if using scheduled ingestion.
INGEST_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Telegram Bot Alerts (OPTIONAL) ---
# Create a bot via @BotFather on Telegram, then get your chat ID.
# Leave blank to disable alert notifications.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE
